# 本地开发配置模板
# 复制本文件为 application-local.yml 并填入真实数据库账号密码
# application-local.yml 已被 .gitignore 忽略，不会提交到仓库
#
# Redis：连接地址/端口默认在 application.yml（localhost:6379）。
# 若本地 Redis 设置了密码，取消下方注释并填入；未设置密码则无需配置。
spring:
  datasource:
    username: your_db_username
    password: your_db_password
#  data:
#    redis:
#      password: your_redis_password